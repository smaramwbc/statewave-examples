# Statewave server
STATEWAVE_URL=http://localhost:8100
STATEWAVE_API_KEY=

# LLM (openai or anthropic)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Optional: override the base URL for OpenAI-compatible proxies
# LLM_BASE_URL=https://api.openai.com

# Optional: default subject for the Vite frontend (can also be set via ?subject= in the URL)
# VITE_SUBJECT=demo-user-1

# Show the retrieved-context side panel (default: true — set to false to hide it)
VITE_SHOW_CONTEXT=true
